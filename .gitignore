# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Planning docs & local config - kept local, not tracked
planning-docs/
local-config/
/PRODUCT.md
/DESIGN.md
/docs
/scripts

# Impeccable design tooling (config, sidecar, critique snapshots) — local
.impeccable/

# Python (resume generator)
__pycache__/
*.pyc
.venv/
